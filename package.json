{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "build:clean": "npm run clean && vite build",
    "clean": "rm -rf dist node_modules/.vite",
    "deploy": "npm run build:clean && echo 'Build complete for deployment'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "echo 'No tests specified' && exit 0",
    "test:coverage": "echo 'No test coverage specified' && exit 0",
    "preview": "vite preview",
    "clean-cache": "npm cache clean --force && rm -rf node_modules/.vite && rm -rf dist",
    "clean-all": "npm run clean-cache && rm -rf node_modules && npm ci",
    "rebuild": "npm run clean-cache && npm run build",
    "cache-bust": "npm run clean-all && npm run build",
    "coderabbit:prepare": "npm run type-check && npm run lint && npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@supabase/supabase-js": "^2.38.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "composio-core": "^0.5.39",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "moment": "^2.30.1",
    "openai": "^4.104.0",
    "postcss": "^8.4.35",
    "react": "^18.3.1",
    "react-avatar": "^5.0.3",
    "react-beautiful-dnd": "^13.1.1",
    "react-big-calendar": "^1.19.4",
    "react-calendar": "^4.8.0",
    "react-csv": "^2.2.2",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.60.0",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.6.3",
    "react-router-hash-link": "^2.4.3",
    "react-select": "^5.10.2",
    "react-simplemde-editor": "^5.2.0",
    "recharts": "^2.15.4",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "uuid": "^9.0.1",
    "vite": "^7.0.6",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/react-dom": "^18.3.0",
    "@types/simple-peer": "^9.11.8",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0"
  }
}
